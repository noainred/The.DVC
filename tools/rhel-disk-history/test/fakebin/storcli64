#!/bin/bash
. "${0%/*}/_common"
: > storcli.log     # 실물처럼 현재 폴더에 로그를 만든다 — 스크립트가 작업 폴더에서 돌리는지 시험이 확인한다
case "$*" in
  "show ctrlcount")          emit raid-ctrlcount.out ;;
  /c*/eall/sall\ show\ all)  c=${1%%/eall*}; emit "raid-${c#/}-pd.out" ;;
  /c*/sall\ show\ all)       c=${1%%/sall*}; emit "raid-${c#/}-pd-noencl.out" ;;
  /c*/vall\ show\ all)       c=${1%%/vall*}; emit "raid-${c#/}-vd.out" ;;
  /c*\ show\ events)         emit "raid-${1#/}-events.out" ;;
esac
echo "syntax error, unexpected \$end"; exit 1
