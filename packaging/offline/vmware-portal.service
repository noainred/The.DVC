[Unit]
Description=VMware Global Monitoring Portal
Documentation=https://github.com/noainred/The.DVC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
EnvironmentFile=@CONFIG_DIR@/portal.env
WorkingDirectory=@PREFIX@/app
# Enable Node's built-in SQLite (used for iDRAC power history). Harmless on
# newer Node where it is unflagged; portal.env may append more options.
# v2.617: 힙 한계 초과 등 치명 오류로 죽을 때 진단 보고서(JS 스택·힙 통계)를 CONFIG_DIR 에 남긴다.
#   --report-exclude-env: 보고서에 환경변수(portal.env 의 AUTH_SECRET·토큰)를 싣지 않는다.
#   힙 스냅샷(--heapsnapshot-near-heap-limit)은 수 GB 를 동기로 써서 오히려 멈추므로 넣지 않았다.
Environment=NODE_OPTIONS="--experimental-sqlite --report-on-fatalerror --report-exclude-env --report-directory=@CONFIG_DIR@"
# 운영 모드 고정 — 미설정이면 express 의 finalhandler 가 'development' 로 판정해
# 처리되지 않은 예외의 스택 트레이스를 HTTP 응답 본문에 그대로 싣는다(경로/모듈 노출).
# 서버에는 전역 에러 핸들러(server/src/index.js 끝)도 있으나 이중 방어로 함께 둔다.
Environment=NODE_ENV=production
ExecStart=@PREFIX@/runtime/node/bin/node @PREFIX@/app/server/src/index.js
# Auto-restart on exit — this is also how the in-app upgrade "재시작" works
# (the process exits under systemd and is restarted with the new code).
Restart=always
RestartSec=2
TimeoutStopSec=20
KillMode=mixed

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
# Allow upgrade to swap @PREFIX@/app (writes alongside it). Adjust if needed.
ReadWritePaths=@PREFIX@ @CONFIG_DIR@

[Install]
WantedBy=multi-user.target
